# Bu dosyayı "config.env" adıyla kopyala ve değerleri doldur. config.env kimseyle paylaşılmamalı.

# Riot çerezleri: SETUP-LOKAL.md, 3. adımdaki "cookie:" satırının tamamı
RIOT_COOKIES=

# Rastgele uzun bir metin (oturum çerezlerini diskte şifrelemek için), örn. 40 karakter
STATE_KEY=

# BotFather token'ı ve senin chat id'n (SETUP-LOKAL.md, 2. adım)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Sunucuda web panelinden bekleme listesi kaydetmek için şifre (kendin uydur)
PANEL_TOKEN=

# İsteğe bağlı: skin adları dili (en-US veya tr-TR)
# VAL_LANG=en-US
